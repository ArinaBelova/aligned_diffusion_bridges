Bootstrap: docker

From: quay.io/condaforge/miniforge3
#From: continuumio/miniconda3

%files
    sbalign.yml
    build_env.sh
    ../setup.py

%environment

%post
    ENV_NAME=$(head -1 sbalign.yml | cut -d' ' -f2)
    echo ". /opt/conda/etc/profile.d/conda.sh" >> $APPTAINER_ENVIRONMENT
    echo "conda activate $ENV_NAME" >> $APPTAINER_ENVIRONMENT

    # truying to execute this to install torch-geometric correctly:
    chmod +x ./build_env.sh
    ./build_env.sh

    # old
    #. /opt/conda/etc/profile.d/conda.sh
    #conda env create -f sbalign.yml -p /opt/conda/envs/$ENV_NAME
    #conda clean --all

%runscript
    cd aligned_diffusion_bridges/
    exec "$@"