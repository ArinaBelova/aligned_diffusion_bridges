   "source": [
    "num_k = 5\n",
    "\n",
    "hurst = [0.5,0.9,0.8,0.7,0.6,0.4,0.3,0.2,0.1]\n",
    "#hurst = [0.5,0.9]\n",
    "n_epochs = 20\n",
    "n_samples = 10000\n",
    "\n",
    "runs = 10\n",
    "\n",
    "WSD_mean = torch.zeros(num_k+1,len(hurst))\n",
    "WSD_std = torch.zeros(num_k+1,len(hurst))\n",
    "\n",
    "for k in range(num_k+1):\n",
    "    for l,H in enumerate(hurst):\n",
    "        if k==0 and H!=0.5:\n",
    "            continue\n",
    "        wsd1 = torch.zeros(runs)\n",
    "        wsd2 = torch.zeros(runs)\n",
    "        for n in range(runs):\n",
    "            print(f'Training with: K={k} - H={H} - RUN={n}')\n",
    "            try:\n",
    "                AlignExperiment.run(f\"--dataset=moon  --h_dim=64  --n_layers=2  --n_epochs={n_epochs}  --reg_weight=1.  --timestep_emb_dim=32  --in_dim=2 --out_dim=2  --diffusivity_schedule=fbb  --max_diffusivity=.7 --H={H} --K={k} --use_drift_in_doobs=True  --activation=silu\").save(\"moon_silu\")\n",
    "            except ValueError:\n",
    "                continue\n",
    "\n",
    "            moon = AlignExperiment.load(\"moon_silu\")\n",
    "            samples = moon.sample(samples_num=n_samples, trials_num=7)\n",
    "            if len(samples.shape) == 4:\n",
    "                samples = samples[:,:,:,0]\n",
    "\n",
    "            marginals = moon.get_marginals(samples_num=n_samples)\n",
    "            wsd1[n] = wasserstein_distance(samples[-1,:,0],marginals['final'][:,0])\n",
    "            wsd2[n] = wasserstein_distance(samples[-1,:,1],marginals['final'][:,1])\n",
    "\n",
    "        # print('wsd for d=1:', wsd1)\n",
    "        # print('wsd for d=2:', wsd2)\n",
    "\n",
    "        mean_wsd1 = torch.mean(wsd1)\n",
    "        mean_wsd2 = torch.mean(wsd2)\n",
    "        WSD_mean[k,l] = (mean_wsd1 + mean_wsd2)/2\n",
    "\n",
    "        std_wsd1 = torch.std(wsd1)\n",
    "        std_wsd2 = torch.std(wsd2)\n",
    "        WSD_std[k,l] = (std_wsd1 + std_wsd2)/2\n",
    "\n",
    "print('FINAL RESULT:\\n',WSD_mean)\n",
    "df_mean = pd.DataFrame(WSD_mean.numpy(), columns=hurst)\n",
    "mean_file_name = f\"moons_MEAN_K{num_k}_H{len(hurst)}_runs{runs}_samples{n_samples}.csv\"\n",
    "df_mean.to_csv(mean_file_name, index=False)\n",
    "\n",
    "df_std = pd.DataFrame(WSD_std.numpy(), columns=hurst)\n",
    "std_file_name = f\"moons_STD_K{num_k}_H{len(hurst)}_runs{runs}_samples{n_samples}.csv\"\n",
    "df_std.to_csv(std_file_name, index=False)\n",
    "\n",
    "\n",
    "\n",
